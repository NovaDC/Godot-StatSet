[sub_resource type="GDScript" id="GDScript_7xdr8"]
resource_name = "ValueEditBehave"
script/source = "@tool
extends TextEdit

func _get_target_parent() -> Control:
	var p := get_parent()
	while p != null and (p.get_script() == null or not p.has_method(\"_value_changed\") or not \"stat_set\" in p):
		p = p.get_parent()
	return p

func _can_drop_data(_at_position: Vector2, data: Variant) -> bool:
	return true

func _drop_data(_at_position: Vector2, data: Variant) -> void:
	var tp := _get_target_parent()
	text = var_to_str(data)
	if tp != null:
		tp._value_changed()
"

