[sub_resource type="GDScript" id="GDScript_pacnf"]
resource_name = "StatSetEditorBriefBehaviour"
script/source = "@tool
extends Control

@export var stat_set:StatSet = null:
	get:
		return stat_set
	set(_value):
		if stat_set != null:
			if stat_set.stat_erased.is_connected(_update_stat_list):
				stat_set.stat_erased.disconnect(_update_stat_list)
			if stat_set.stat_added.is_connected(_update_stat_list):
				stat_set.stat_added.disconnect(_update_stat_list)
			if stat_set.post_stat_change.is_connected(_update_stat_list):
				stat_set.post_stat_change.disconnect(_update_stat_list)
			if stat_set.post_prototype_change.is_connected(_update_stat_list):
				stat_set.post_prototype_change.disconnect(_update_stat_list)
		stat_set = _value
		if stat_set != null:
			if not stat_set.stat_erased.is_connected(_update_stat_list):
				stat_set.stat_erased.connect(_update_stat_list)
			if not stat_set.stat_added.is_connected(_update_stat_list):
				stat_set.stat_added.connect(_update_stat_list)
			if not stat_set.post_stat_change.is_connected(_update_stat_list):
				stat_set.post_stat_change.connect(_update_stat_list)
			if not stat_set.post_prototype_change.is_connected(_update_stat_list):
				stat_set.post_prototype_change.connect(_update_stat_list)
		_on_stat_selected()

var _current_editor_for_metatype_is:String = \"\"

func _ready() -> void:
	stat_set = stat_set
	%add_button.icon = NovaTools.get_editor_icon_named(\"Add\")
	%remove_button.icon = NovaTools.get_editor_icon_named(\"Remove\")

func _extract_drop_prototype(data:Variant) -> Array:
	match typeof(data):
		TYPE_OBJECT when data is StatPrototype:
			return [data]
		TYPE_STRING, TYPE_STRING_NAME when ResourceLoader.exists(data):
			return [load(data)]
		TYPE_ARRAY, TYPE_PACKED_STRING_ARRAY:
			var ret:Array = []
			for x in data:
				var ex := _extract_drop_prototype(x)
				ret.append_array(ex)
			return ret
		TYPE_DICTIONARY:
			if data.has(\"value\"):
				return _extract_drop_prototype(data[\"value\"])
			elif data.has(\"resource\"):
				return _extract_drop_prototype(data[\"resource\"])
			elif data.has(\"path\"):
				return _extract_drop_prototype(data[\"path\"])
			elif data.has(\"files\"):
				return _extract_drop_prototype(data[\"files\"])
	return []

func _enter_tree() -> void:
	stat_set = stat_set

func get_selected_stat() -> StatPrototype:
	if stat_set == null or %stat_list == null or not %stat_list.is_anything_selected():
		return null
	var selected = %stat_list.get_selected_items()
	return %stat_list.get_item_metadata(selected[0])

func set_selected_stat(proto:StatPrototype) -> bool:
	if stat_set == null or %stat_list == null:
		return false
	if proto == null:
		var was_selected = %stat_list.is_anything_selected()
		%stat_list.deselect_all()
		_on_stat_selected()
		return was_selected
	for i in range(%stat_list.item_count):
		if %stat_list.get_item_metadata(i) == proto:
			%stat_list.select(i)
			_on_stat_selected()
			return true
	return false

func _on_add_stat():
	if stat_set == null or %prototype_type.get_selected_string() == \"\":
		return
	var new_proto = NovaTools.instantiate_this(%prototype_type.get_selected_string())
	stat_set.reset_stat(new_proto)
	set_selected_stat(new_proto)

func _on_del_stat():
	var selected := get_selected_stat()
	if selected == null:
		return
	stat_set.erase_stat(selected)

func _update_stat_list(_1 = null, _2 = null, _3 = null):
	if stat_set == null:
		return
	var selected := get_selected_stat()
	%stat_list.clear()
	for proto in stat_set.prototypes():
		var name := proto.name
		var index = %stat_list.add_item(\"%s <%s>\" % [name, NovaTools.get_class_name(proto)])
		%stat_list.set_item_metadata(index, proto)
		if proto == selected and selected != null:
			%stat_list.select(index)

func _on_stat_selected(_1 = null):
	if stat_set == null:
		return
	var selected := get_selected_stat()
	if selected == null:
		for child in %prototype_editor_root.get_children():
			child.queue_free()
		return
	var expected_display_type := selected.editing_display_type
	if expected_display_type != expected_display_type or _current_editor_for_metatype_is == \"\":
		for child in %prototype_editor_root.get_children():
			child.queue_free()
		var new_kid := NovaTools.instantiate_this(expected_display_type)
		%prototype_editor_root.add_child(new_kid)
		_current_editor_for_metatype_is = expected_display_type
	if %prototype_editor_root.get_child_count() > 0:
		%prototype_editor_root.get_child(0).prototype = selected
	%prototype_type.set_selected_string(NovaTools.get_class_name(selected))
	_update_value()

func _update_value(_1 = null, _2 = null, _3 = null):
	var proto := get_selected_stat()
	if stat_set == null or proto == null:
		return
	%value_edit.text = proto.string_from_value(stat_set.get_stat(proto))

func _value_changed():
	var proto := get_selected_stat()
	if stat_set == null or proto == null:
		return
	stat_set.set_stat(proto, proto.value_from_string(%value_edit.text))
	%value_edit.text = proto.string_from_value(stat_set.get_stat(proto))

func _gui_input(e:InputEvent):
	if e.is_action_pressed(\"ui_accept\"):
		_value_changed()
		accept_event()
"

[sub_resource type="GDScript" id="GDScript_cppx0"]
resource_name = "ItemListBehave"
script/source = "@tool
extends ItemList

func _get_target_parent() -> Control:
	var p := get_parent()
	while p != null and (p.get_script() == null or not p.has_method(\"_extract_drop_prototype\") or not p.has_method(\"_update_stat_list\") or not \"stat_set\" in p):
		p = p.get_parent()
	return p

func _can_drop_data(_at_position: Vector2, data: Variant) -> bool:
	var tp := _get_target_parent()
	return tp != null and not tp._extract_drop_prototype(data).is_empty()

func _drop_data(_at_position: Vector2, data: Variant) -> void:
	var tp := _get_target_parent()
	if tp == null:
		return
	var prots = tp._extract_drop_prototype(data)
	for p in prots:
		if not tp.stat_set.has_stat(p):
			print(p)
			tp.stat_set.reset_stat(p)
	tp._update_stat_list()

func _gui_input(event: InputEvent) -> void:
	var tp := _get_target_parent()
	if tp == null:
		return
	if event.is_action_pressed(\"ui_text_delete\"):
		tp._on_del_stat()
		accept_event()
	elif event.is_action_pressed(\"ui_accept\"):
		tp._value_changed()
		accept_event()
"

[sub_resource type="GDScript" id="GDScript_a08g6"]
resource_name = "PrototypeSelectOptionButtonBehave"
script/source = "@tool

extends OptionButton

func _enter_tree() -> void:
	if not pressed.is_connected(_update):
		pressed.connect(_update)

func _ready() -> void:
	_update()
	if not pressed.is_connected(_update):
		pressed.connect(_update)

func _update():
	var selected := get_selected_string()
	clear()
	var names := NovaTools.get_classes_inheriting(\"StatPrototype\", false, true)
	names.append(\"StatPrototype\")
	for i in range(names.size()):
		var name := names[i]
		add_item(name)
		if name == selected:
			select(i)

func get_selected_string() -> String:
	var id := get_selected_id()
	if id >= 0:
		return get_item_text(get_item_index(id))
	return \"\"

func set_selected_string(value:String):
	for index in range(item_count):
		if get_item_text(index) == value:
			select(index)
			return
"

